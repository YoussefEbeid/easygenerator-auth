NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/auth_app?retryWrites=true&w=majority
MONGODB_TEST_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/auth_app_test?retryWrites=true&w=majority
JWT_SECRET=replace-me-with-at-least-32-random-characters
JWT_EXPIRES_IN_SECONDS=3600
CORS_ORIGIN=http://localhost:5173
DNS_SERVERS=